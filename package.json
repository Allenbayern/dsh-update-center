{
  "name": "@dsh-external/dsh-update-center",
  "version": "0.3.0",
  "description": "DSH 更新中心：汇总 DSH 本体、插件套件、Docker 容器、APT 安全包、全局 CLI 工具链与本地 Python 虚拟环境 (.venv) 的零配置自动发现与一键更新",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Allenbayern/dsh-update-center.git"
  },
  "homepage": "https://github.com/Allenbayern/dsh-update-center#readme",
  "bugs": {
    "url": "https://github.com/Allenbayern/dsh-update-center/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "updater",
    "docker",
    "apt",
    "venv",
    "ops"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "node ./node_modules/tsdown/dist/run.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
